# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (needed now) ---
# MongoDB Atlas > Database > Connect > Drivers. Add a database name before the "?", e.g.
# mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/pdf-analyzer?retryWrites=true&w=majority
MONGO_URI=

# --- Auth (needed from Phase 2) ---
# Any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- AI (needed from Phase 3) ---
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Payments (needed from Phase 5) ---
# Razorpay Dashboard (Test Mode) > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# You choose this when creating the webhook in the Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=
